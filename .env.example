# Copy to .env (gitignored) and fill in. Never commit real keys.

# Claude API — used for director extraction + namesake matching (Haiku).
ANTHROPIC_API_KEY=

# Signalhire — founder email + phone + LinkedIn reveal (Phase 3). Required if
# enrich.signalhire.enabled.
SIGNALHIRE_API_KEY=

# Optional paid LinkedIn enrichment (OFF by default). Only one is needed.
PROXYCURL_API_KEY=
CORESIGNAL_API_KEY=

# Google Sheets sync (Phase 5b).
#  - Local dev: place the service-account JSON at google_service_account.json
#    (gitignored) and set GOOGLE_SHEETS_KEY below (or config.yaml sheets.spreadsheet_key).
#  - CI (GitHub Actions): set BOTH env vars as repo secrets instead of the file —
#    GOOGLE_SERVICE_ACCOUNT_JSON = the entire JSON string, GOOGLE_SHEETS_KEY = sheet key.
GOOGLE_SHEETS_KEY=
# GOOGLE_SERVICE_ACCOUNT_JSON=
